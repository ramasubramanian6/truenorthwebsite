PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/truenorth?appName=Cluster0
FRONTEND_URL=https://truenorthitc.com

# New enquiry emails (routes/contact.js). Any SMTP account works, for example
# Google Workspace (smtp.gmail.com, an App Password) or Zoho (smtp.zoho.in).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=support@truenorthitc.com
SMTP_PASS=your_app_password
# Who receives the alerts (comma-separated for several people)
NOTIFY_TO=support@truenorthitc.com
# Optional; defaults to "True North Website" <SMTP_USER> for team alerts and
# "True North IT Consulting" <SMTP_USER> for the visitor's auto-reply
MAIL_FROM=
# Optional; where visitors' replies to the auto-reply go (default support@truenorthitc.com)
REPLY_TO=
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
